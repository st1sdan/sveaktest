mixin icon-play
  svg.icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
    path(d="M8 5.5v13l11-6.5z")

mixin icon-circle
  svg.icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
    circle(cx="12" cy="12" r="7")

mixin icon-square
  svg.icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
    rect(x="5.5" y="5.5" width="13" height="13" rx="3")

mixin icon-close
  svg.icon(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
    path(d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round")

mixin icon-arrow
  svg.icon.icon--arrow(viewBox="0 0 24 24" aria-hidden="true" focusable="false")
    path(d="M5 12h13M12 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
